# No secrets. Copy to .env locally (never commit .env).
API_PORT=8000
DATABASE_URL=sqlite:///./beosabasi.db
# Local S3 stand-in (TK-002, printed by dev-up; real R2 values arrive in TK-003)
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=beosabasi-dev
S3_KEY_ID=beosabasidevkey01
S3_KEY_SECRET=dev-only-ganti-di-env-lokal
